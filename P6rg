# gradle script 
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'master', url: 'https://github.com/manjushree-devops/jenkins-gradeldemo.git'
            }
        }

        stage('Build') {
            steps {
                sh 'chmod +x gradlew'
                sh './gradlew build'
            }
        }

        stage('Run') {
            steps {
                sh './gradlew run'
            }
        }

        stage('Output') {
            steps {
                sh 'echo "Gradle pipeline project by Manjushree G"'
            }
        }

    }
}
