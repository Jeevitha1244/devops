# Pipeline Scripts to Paste Directly on jenkins
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'master', url: 'https://github.com/manjushreedevops/jenkins-maven-demo.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean install'
            }
        }

        stage('Output') {
            steps {
                sh 'echo "Maven pipeline project by Manjushree G"'
            }
        }

    }
}
